# Copy this file to .env and fill in the values you need.

# Required in production: a long random string used to sign login tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Optional: enables real AI replies from Claude. Without it the offline assistant is used.
ANTHROPIC_API_KEY=

# Optional overrides
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=low
# DATABASE_URL=sqlite:///./codetogether.db
# CORS_ORIGINS=https://your-frontend.example.com
