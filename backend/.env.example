# Copy this file to .env and fill in the values you need.

# "production" turns on startup checks: SECRET_KEY, a Postgres DATABASE_URL and CORS_ORIGINS
# must be set, and localhost origins are no longer allowed. See docs/DEPLOY.md.
# APP_ENV=production

# Required in production: a long random string used to sign login tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Optional, paid: enables AI replies from Claude.
ANTHROPIC_API_KEY=

# Free tier: Google Gemini. Get a key at https://aistudio.google.com/apikey
# Used when no Anthropic key is set. Free-tier prompts may be used by Google to improve its products.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Free local AI with Ollama (https://ollama.com). Used when no Anthropic key is set.
# Install Ollama, then run:  ollama pull qwen2.5-coder:1.5b
# OLLAMA_MODEL=qwen2.5-coder:1.5b
# OLLAMA_URL=http://localhost:11434

# AI replies each user may request per hour (0 = unlimited). Protects free-tier quotas.
# AI_REQUESTS_PER_HOUR=20

# Optional overrides
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=low
# Defaults to a SQLite file. For Postgres (e.g. a free Neon database):
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Allowed frontend URLs, comma-separated:
# CORS_ORIGINS=https://codetogether-web.onrender.com
